    "test": "tsx --test tests/interaction.test.ts",
    "test:browser": "tsx --test tests/browser.test.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
