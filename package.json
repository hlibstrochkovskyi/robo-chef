  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/three": "^0.183.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.6"
  }
